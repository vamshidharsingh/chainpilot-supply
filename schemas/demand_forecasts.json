{
  "name": "demand_forecasts",
  "description": "Manual forecast scenarios rather than model-generated predictions.",
  "fields": {
    "product_id": {
      "type": "string",
      "ref": "products"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "forecast_units": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "type": "string",
      "enum": [
        "manual",
        "moving_average"
      ]
    }
  },
  "writable": true,
  "unique": []
}
